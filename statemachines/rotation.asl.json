{
  "Comment": "IAM access key rotation workflow — flags the account only, never mutates the live key (see rotation-iam-key-fn)",
  "StartAt": "RunIamKeyRotation",
  "States": {
    "RunIamKeyRotation": {
      "Type": "Task",
      "Resource": "${RotationIamKeyFunctionArn}",
      "ResultPath": "$.rotationTask",
      "Next": "UpdateIamAccount",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "WriteRotationFailureAudit"
        }
      ]
    },
    "UpdateIamAccount": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${IamTableName}",
        "Key": {
          "AccountIdHash": { "S.$": "$.accountIdHash" }
        },
        "UpdateExpression": "SET #s = :status",
        "ExpressionAttributeNames": {
          "#s": "Status"
        },
        "ExpressionAttributeValues": {
          ":status": { "S": "active" }
        }
      },
      "ResultPath": "$.inventoryUpdate",
      "Next": "WriteRotationSuccessAudit"
    },
    "WriteRotationSuccessAudit": {
      "Type": "Task",
      "ResultPath": null,
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "${AuditTableName}",
        "Item": {
          "EntityId": { "S.$": "$.accountIdHash" },
          "EventTimestamp": { "S.$": "$$.State.EnteredTime" },
          "EventType": { "S": "ROTATION_COMPLETE" },
          "Actor": { "S": "rotation-sfn" },
          "Outcome": { "S": "SUCCESS" }
        }
      },
      "Next": "PublishRotationCompletion"
    },
    "PublishRotationCompletion": {
      "Type": "Task",
      "ResultPath": null,
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${CompletionsTopicArn}",
        "Subject": "IAM key rotation flagged",
        "Message.$": "States.Format('accountIdHash={} status=SUCCESS', $.accountIdHash)"
      },
      "End": true
    },
    "WriteRotationFailureAudit": {
      "Type": "Task",
      "ResultPath": null,
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "${AuditTableName}",
        "Item": {
          "EntityId": { "S.$": "$.accountIdHash" },
          "EventTimestamp": { "S.$": "$$.State.EnteredTime" },
          "EventType": { "S": "ROTATION_COMPLETE" },
          "Actor": { "S": "rotation-sfn" },
          "Outcome": { "S": "FAILURE" },
          "Detail": { "S.$": "States.JsonToString($.error)" }
        }
      },
      "Next": "RotationFailed"
    },
    "RotationFailed": {
      "Type": "Fail",
      "Error": "RotationWorkflowFailed"
    }
  }
}
