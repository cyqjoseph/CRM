{
  "Comment": "Password reset execution workflow — generates and hashes a temporary credential, never handles or stores it in plaintext (see password-reset-executor-fn)",
  "StartAt": "GenerateTemporaryPassword",
  "States": {
    "GenerateTemporaryPassword": {
      "Type": "Task",
      "Resource": "${PasswordResetExecutorFunctionArn}",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "ResultPath": "$.executorResult",
      "Next": "UpdateResetRequestCompleted",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "WriteResetFailureAudit"
        }
      ]
    },
    "UpdateResetRequestCompleted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${PasswordResetTableName}",
        "Key": {
          "RequestId": { "S.$": "$.requestId" },
          "Timestamp": { "S.$": "$.timestamp" }
        },
        "UpdateExpression": "SET #s = :status, CompletionTimestamp = :completedAt",
        "ExpressionAttributeNames": {
          "#s": "Status"
        },
        "ExpressionAttributeValues": {
          ":status": { "S": "completed" },
          ":completedAt": { "S.$": "$$.State.EnteredTime" }
        }
      },
      "ResultPath": "$.requestUpdate",
      "Next": "UpdateAccountResetStatus"
    },
    "UpdateAccountResetStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${IamTableName}",
        "Key": {
          "AccountIdHash": { "S.$": "$.accountId" }
        },
        "UpdateExpression": "SET RotationStatus = :status",
        "ExpressionAttributeValues": {
          ":status": { "S": "completed" }
        }
      },
      "ResultPath": "$.inventoryUpdate",
      "Next": "WriteResetSuccessAudit"
    },
    "WriteResetSuccessAudit": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "${AuditTableName}",
        "Item": {
          "EntityId": { "S.$": "$.accountId" },
          "EventTimestamp": { "S.$": "$$.State.EnteredTime" },
          "EventType": { "S": "PASSWORD_RESET_COMPLETE" },
          "Actor": { "S": "password-reset-sfn" },
          "Outcome": { "S": "SUCCESS" },
          "Detail": { "S.$": "States.JsonToString($.executorResult)" }
        }
      },
      "Next": "PublishResetCompletion"
    },
    "PublishResetCompletion": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${NotificationsTopicArn}",
        "Subject": "Password reset complete",
        "Message": "Your password has been reset. New temporary password sent to your email."
      },
      "End": true
    },
    "WriteResetFailureAudit": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "${AuditTableName}",
        "Item": {
          "EntityId": { "S.$": "$.accountId" },
          "EventTimestamp": { "S.$": "$$.State.EnteredTime" },
          "EventType": { "S": "PASSWORD_RESET_COMPLETE" },
          "Actor": { "S": "password-reset-sfn" },
          "Outcome": { "S": "FAILURE" },
          "Detail": { "S.$": "States.JsonToString($.error)" }
        }
      },
      "Next": "ResetFailed"
    },
    "ResetFailed": {
      "Type": "Fail",
      "Error": "PasswordResetWorkflowFailed"
    }
  }
}
